<Window x:Class="Winfred.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Winfred"
        Title="Winfred"
        Width="700"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Window.Resources>
        <local:ActionSubtitleConverter x:Key="ActionSubtitle"/>
        <local:NullToVisibilityConverter x:Key="NullToHidden"/>
        <local:NullToVisibilityConverter x:Key="NullToVisible" Invert="True"/>
    </Window.Resources>
    <Grid Margin="20">
        <Border CornerRadius="12"
                Background="{DynamicResource WinBg}"
                BorderBrush="{DynamicResource WinBorder}"
                BorderThickness="1"
                Padding="10,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.45"/>
            </Border.Effect>
            <DockPanel>
                <!-- Search field: hat · input · preferences cog, the way Alfred lays it out. -->
                <Grid DockPanel.Dock="Top" MinHeight="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0"
                                    x:Name="HatMark"
                                    Template="{StaticResource WinHatMark}"
                                    Width="40" Height="40"
                                    Margin="2,0,12,0"
                                    VerticalAlignment="Center"
                                    IsTabStop="False"/>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="Typeahead"
                                   FontSize="{DynamicResource WinInputSize}"
                                   FontWeight="Normal"
                                   Padding="2,4"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="Input"
                                 Style="{x:Null}"
                                 FontSize="{DynamicResource WinInputSize}"
                                 FontWeight="Normal"
                                 Padding="2,4"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource WinText}"
                                 CaretBrush="{DynamicResource WinText}"
                                 VerticalAlignment="Center"
                                 TextChanged="Input_TextChanged"/>
                        <TextBlock x:Name="Placeholder"
                                   Text="Search applications, the web, files, notes, “10+25” …"
                                   FontSize="{DynamicResource WinInputSize}"
                                   FontWeight="Normal"
                                   Padding="2,4"
                                   Foreground="{DynamicResource WinPlaceholder}"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <Button Grid.Column="2"
                            x:Name="CogButton"
                            Width="28" Height="28"
                            Margin="8,0,2,0"
                            VerticalAlignment="Center"
                            ToolTip="Settings (Ctrl+,)"
                            Cursor="Hand"
                            PreviewMouseLeftButtonDown="Cog_PreviewMouseLeftButtonDown">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                                    <TextBlock Text="&#xE713;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{DynamicResource WinShortcut}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WinHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Rectangle x:Name="Divider"
                           DockPanel.Dock="Top"
                           Height="1"
                           Margin="4,6,4,2"
                           Fill="{DynamicResource WinDivider}"
                           Visibility="Collapsed"/>

                <ListBox x:Name="Results"
                         Margin="0,2,0,0"
                         MaxHeight="470"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.CanContentScroll="True"
                         Visibility="Collapsed"
                         FocusVisualStyle="{x:Null}"
                         PreviewMouseMove="Results_PreviewMouseMove"
                         PreviewMouseLeftButtonDown="Results_PreviewMouseLeftButtonDown"
                         SelectionChanged="Results_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" CornerRadius="6" Padding="8,6" Margin="0,1" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WinHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WinSelected}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="{DynamicResource WinResultIconSize}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0"
                                      Width="{DynamicResource WinResultIconSize}"
                                      Height="{DynamicResource WinResultIconSize}"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center">
                                    <Image Source="{Binding IconImage}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding IconImage, Converter={StaticResource NullToHidden}}"/>
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="{DynamicResource WinIconSize}"
                                               FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Emoji, Segoe UI"
                                               Foreground="{DynamicResource WinText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IconImage, Converter={StaticResource NullToVisible}}"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock x:Name="TitleText"
                                               Text="{Binding Title}"
                                               FontSize="{DynamicResource WinTitleSize}"
                                               FontWeight="Normal"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource WinText}"/>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock x:Name="SubtitleText"
                                               FontSize="{DynamicResource WinSubSize}"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource WinSubtext}"/>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource ActionSubtitle}">
                                                <Binding/>
                                                <Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                                                <Binding Source="{x:Static local:ModifierState.Instance}" Path="Tick"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           x:Name="ShortcutText"
                                           Text="{Binding Shortcut}"
                                           FontSize="{DynamicResource WinShortcutSize}"
                                           FontWeight="Normal"
                                           Margin="4,0,2,0"
                                           MinWidth="16"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource WinShortcut}"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                             Value="True">
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource WinSelectedText}"/>
                                    <Setter TargetName="SubtitleText" Property="Foreground" Value="{DynamicResource WinSelectedSubtext}"/>
                                    <Setter TargetName="ShortcutText" Property="Foreground" Value="{DynamicResource WinShortcutSelected}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
