<Window x:Class="Winfred.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winfred"
        Width="700"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="True"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="24">
        <Border CornerRadius="14"
                Background="{DynamicResource WinBg}"
                BorderBrush="{DynamicResource WinBorder}"
                BorderThickness="1"
                Padding="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0"
                                    x:Name="HatMark"
                                    Template="{StaticResource WinHatMark}"
                                    Width="30" Height="30"
                                    Margin="4,0,12,0"
                                    VerticalAlignment="Center"
                                    IsTabStop="False"/>
                    <TextBox x:Name="Input"
                             Grid.Column="1"
                             FontSize="{DynamicResource WinInputSize}"
                             Padding="6,4"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{DynamicResource WinText}"
                             CaretBrush="{DynamicResource WinText}"
                             TextChanged="Input_TextChanged"/>
                    <TextBlock x:Name="Placeholder"
                               Grid.Column="1"
                               Text="Search applications, the web, files, notes, “10+25” …"
                               FontSize="{DynamicResource WinInputSize}"
                               Margin="8,0,0,0"
                               Foreground="{DynamicResource WinPlaceholder}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"/>
                </Grid>
                <ListBox x:Name="Results"
                         Margin="0,10,0,0"
                         MaxHeight="470"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="Results_PreviewMouseLeftButtonDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" CornerRadius="8" Padding="10,8" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WinHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource WinSelected}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           FontSize="{DynamicResource WinIconSize}"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI Emoji"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="{DynamicResource WinTitleSize}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource WinText}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="{DynamicResource WinSubSize}"
                                               Foreground="{DynamicResource WinSubtext}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           x:Name="HintText"
                                           Text="{Binding Hint}"
                                           FontSize="{DynamicResource WinHintSize}"
                                           Margin="12,0,2,0"
                                           MaxWidth="230"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource WinSubtext}"
                                           Opacity="0"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                             Value="True">
                                    <Setter TargetName="HintText" Property="Opacity" Value="0.85"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>
    </Grid>
</Window>
